# Python environments and generated Python artifacts
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local databases (edge outbox + server store)
*.sqlite
*.sqlite3
*.db

# Model weights are never committed. models/rdd2022-yolov8m-r1.pt is 52 MB and
# is reproduced by scripts/train_kaggle.md; committing it once already took this
# repository to 402 MB. Fetch it with scripts/download_weights.sh.
models/*.pt

# macOS metadata
.DS_Store

# Local assistant/editor configuration
.agents/
.claude/

# Streamlit local configuration and caches
.streamlit/

# Generated application output
output/
uploads/
*.log
# Runtime data: databases, evidence photos, saved GPS fix
var/
