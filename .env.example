# RoadScope configuration. Copy to .env and edit.
#   cp .env.example .env
# Every value is optional; defaults live in src/roadscope/config.py.

# --- Identity -------------------------------------------------------------
ROADSCOPE_DEVICE_ID=van-01

# --- Transport ------------------------------------------------------------
ROADSCOPE_MQTT_URL=tcp://localhost:1883
ROADSCOPE_MQTT_TOPIC_PREFIX=roadscope
ROADSCOPE_MQTT_QOS=1

# --- Capture --------------------------------------------------------------
# DroidCam / IP Web Camera on the phone hotspot. Leave unset for the synthetic
# test source used by the unit tests.
# ROADSCOPE_CAMERA_URL=http://192.168.1.42:8080/stream
ROADSCOPE_CAMERA_FPS=30

# --- Detection ------------------------------------------------------------
# Explicit path wins, and a missing file is an error rather than a silent
# fallback to a different model.
# ROADSCOPE_MODEL_PATH=/absolute/path/to/best.pt
ROADSCOPE_MODEL_NAME=roadscope-yolov8m-seg.pt
ROADSCOPE_CONF_THRESHOLD=0.35
ROADSCOPE_IOU_THRESHOLD=0.50
ROADSCOPE_IMGSZ=960
# Set to "0" or "mps" on a CUDA/Apple-Silicon machine to use the GPU.
ROADSCOPE_DEVICE=cpu

# --- Pipeline -------------------------------------------------------------
ROADSCOPE_QUEUE_SIZE=8
ROADSCOPE_INFER_TARGET_MS=120
ROADSCOPE_SAMPLE_HZ=5.0

# --- Fusion ---------------------------------------------------------------
ROADSCOPE_GEOFENCE_M=15.0
ROADSCOPE_TRACK_MIN_FRAMES=3
ROADSCOPE_TRACK_MAX_AGE_S=2.0
ROADSCOPE_IOU_MATCH_THRESHOLD=0.30

# --- GPS quality gates ---------------------------------------------------
ROADSCOPE_GPS_MAX_ACCURACY_M=10.0
ROADSCOPE_GPS_MIN_SATS=6
ROADSCOPE_GPS_MAX_HDOP=2.0
ROADSCOPE_GPS_MAX_AGE_S=2.0

# --- Civil ----------------------------------------------------------------
ROADSCOPE_SAMPLE_UNIT_AREA_M2=250.0
ROADSCOPE_CORRIDOR_AREA_M2=500.0

# --- Server ---------------------------------------------------------------
ROADSCOPE_SERVER_HOST=0.0.0.0
ROADSCOPE_SERVER_PORT=8000

# --- Logging --------------------------------------------------------------
ROADSCOPE_LOG_LEVEL=INFO
# ROADSCOPE_LOG_FILE=var/roadscope.log

# --- Paths ----------------------------------------------------------------
# Override only if the project root cannot be discovered automatically.
# ROADSCOPE_ROOT=/absolute/path/to/roadscope